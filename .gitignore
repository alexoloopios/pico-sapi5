# ---------------------------------------------------------------------------
# Build output
#
# Everything here is regenerated by tools\build_all.ps1 in about twenty seconds,
# so none of it belongs in the repository. What does belong is under src/,
# tools/, installer/, third_party/pico/ and lang/ -- the engine sources, the
# vendored Pico engine and its lingware.
# ---------------------------------------------------------------------------
build/
dist/
out/
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
Win32/

# ---------------------------------------------------------------------------
# CMake
# ---------------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
CMakeUserPresets.json
_deps/
compile_commands.json

# ---------------------------------------------------------------------------
# Visual Studio and MSBuild
# ---------------------------------------------------------------------------
.vs/
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
*.opensdf
*.sdf
*.ipch
*.aps
*.ncb
*.tlog
*.log
*.lastbuildstate
*.idb
*.pdb
*.ilk
*.iobj
*.ipdb
*.exp
*.obj
*.tli
*.tlh
*.res
*.pch

# ---------------------------------------------------------------------------
# Compiled output, wherever it lands
#
# The vendored Pico engine ships as source, not as a prebuilt DLL, so there is
# nothing under third_party/ that these would wrongly exclude.
# ---------------------------------------------------------------------------
*.exe
*.dll
*.lib
*.a
*.o
*.so

# ---------------------------------------------------------------------------
# Test and tool output
#
# pico_render and pico_sapitest both write WAV files beside themselves. The ones
# under samples/ are the voice demonstrations and are kept deliberately.
# ---------------------------------------------------------------------------
*.wav
!samples/*.wav

# The engine's own diagnostic log, if anyone runs a build with logging on.
pico_sapi5.log

# ---------------------------------------------------------------------------
# Editors and agents
# ---------------------------------------------------------------------------
.claude/
.vscode/
.idea/
*.code-workspace
*~
*.swp
.DS_Store
Thumbs.db
